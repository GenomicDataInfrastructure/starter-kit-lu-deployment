{
    "htsgetConfig": {
        "props": {
            "port": "3000",
            "host": "https://htsget.dev.gdi.lu/"
        },
        "variants": {
            "enabled": true,
            "dataSourceRegistry": {
                "sources": [
                    {
                        "pattern": "^Case1_index_chrom(?P<chrom>.*).g.vcf.gz$",
                        "path": "/mnt/gdi-synth-data-nfs/b1mg-rd-synthetic-data/case1_index/Case1_IC.{chrom}.g.vcf.gz"
                    }, 
                    {
                        "pattern": "^GDIF00(?P<accession>.*)$",
                        "path": "/mnt/gdi-synth-data-nfs/b1mg-rd-synthetic-data/vcf_symlinks/{accession}"
                    }, 
                    {
                        "pattern": "^variants/b1mg-rd-synthetic-data/(?P<accession>.*)$",
                        "path": "https://minio.dev.gdi.lu/inbox/{accession}"
                    }
                ]

            }
        }
    }
}